@model List<BoardingHouseManagement.Services.Invoice.InvoiceListItemDto>
@using BoardingHouseManagement.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hóa đơn theo tháng";
}

<div class="card">
    <h5 class="card-header d-flex justify-content-between align-items-center">
        <span>Danh sách hóa đơn</span>
        <a href="~/Admin/Invoices/Create" class="btn btn-primary btn-sm">Tạo hóa đơn</a>
    </h5>
    @if (TempData["InvoiceWarning"] != null)
    {
        <div class="px-4 pt-3">
            <div class="alert alert-warning mb-0">@TempData["InvoiceWarning"]</div>
        </div>
    }
    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Kỳ</th>
                    <th>Khách</th>
                    <th>Hợp đồng</th>
                    <th>Phòng</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.InvoiceCode</strong></td>
                        <td>@item.Month/@item.Year</td>
                        <td>@item.TenantName</td>
                        <td>@item.ContractCode</td>
                        <td>@item.RoomNumber</td>
                        <td>@item.TotalAmount.ToString("N0")</td>
                        <td>
                            @switch (item.Status)
                            {
                                case InvoiceStatus.Pending:
                                    <span class="badge bg-label-warning">Chưa thanh toán</span>
                                    break;
                                case InvoiceStatus.Paid:
                                    <span class="badge bg-label-success">Đã thanh toán</span>
                                    break;
                                case InvoiceStatus.Overdue:
                                    <span class="badge bg-label-danger">Quá hạn</span>
                                    break;
                            }
                            @if (item.WaitingConfirmationPaymentId != null)
                            {
                                <span class="badge bg-label-info ms-1">Khách đã báo CK — chờ xác nhận</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                                @if (item.WaitingConfirmationPaymentId != null)
                                {
                                    <form asp-controller="PaymentAdmin" asp-action="Confirm" asp-route-paymentId="@item.WaitingConfirmationPaymentId.Value" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success">Xác nhận thanh toán</button>
                                    </form>
                                    <a href="~/Admin/Payment/WaitingConfirmation" class="btn btn-sm btn-outline-secondary">Chi tiết / từ chối</a>
                                }
                                @if (item.Status != InvoiceStatus.Paid && item.WaitingConfirmationPaymentId == null)
                                {
                                    <a href="~/Admin/Invoices/Edit/@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
