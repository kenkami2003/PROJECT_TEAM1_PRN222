@using BoardingHouseManagement.Services.Payment
@model List<WaitingConfirmationPaymentDto>

@{
    Layout = "_AdminLayout";
}

<div class="card mt-4">
    <div class="card-body">
        <h3 class="mb-3">Các payment chờ xác nhận</h3>

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-secondary">Không có payment nào đang chờ xác nhận.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Hóa đơn</th>
                            <th>Người thuê</th>
                            <th>Số tiền</th>
                            <th>Provider Order Code</th>
                            <th>QR Content</th>
                            <th>Khách báo thanh toán</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.InvoiceCode</td>
                                <td>@item.TenantName</td>
                                <td>@item.Amount.ToString("N0")</td>
                                <td>@item.ProviderOrderCode</td>
                                <td>
                                    <textarea class="form-control" rows="3" readonly>@item.QrContent</textarea>
                                </td>
                                <td>@item.CustomerMarkedPaidAt.ToString("g")</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <form asp-controller="PaymentAdmin" asp-action="Confirm" asp-route-paymentId="@item.PaymentId" method="post">
                                            <button type="submit" class="btn btn-success btn-sm">Xác nhận</button>
                                        </form>
                                        <form asp-controller="PaymentAdmin" asp-action="Reject" asp-route-paymentId="@item.PaymentId" method="post">
                                            <div class="mt-1">
                                                <input name="note" class="form-control form-control-sm" placeholder="Ghi chú (tuỳ chọn)" />
                                            </div>
                                            <button type="submit" class="btn btn-danger btn-sm mt-1">Từ chối</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

