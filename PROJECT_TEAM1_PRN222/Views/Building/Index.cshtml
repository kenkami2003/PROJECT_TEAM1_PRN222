@using BoardingHouseManagement.Models
@model IEnumerable<BoardingHouseManagement.Models.Property>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_AdminLayout";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="container mt-4">
    <h2 class="mb-4">Quản lý dãy trọ</h2>

    <form method="get" asp-action="Index" class="mb-4">
        <select name="propertyId" class="form-control w-25 d-inline shadow-sm">
            <option value="">-- Tất cả khu trọ --</option>
            @foreach (var p in ViewBag.PropertyList)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-primary ms-2 shadow-sm">Tìm kiếm</button>
    </form>

    @foreach (var property in Model)
    {
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold">@property.Name</h5>
                    <small><i class="fas fa-map-marker-alt me-1"></i>@property.Address</small>
                </div>
                <div class="text-end">
                    <span class="badge bg-light text-dark me-1">
                        <i class="fas fa-bolt text-warning"></i> Điện: @property.PriceUnitElectricity.ToString("N0")đ
                    </span>
                    <span class="badge bg-light text-dark me-1">
                        <i class="fas fa-tint text-primary"></i> Nước: @property.PriceUnitWater.ToString("N0")đ
                    </span>
                    <span class="badge bg-light text-dark">
                        <i class="fas fa-concierge-bell text-success"></i> DV: @property.ServiceFee.ToString("N0")đ
                    </span>
                </div>
            </div>

            <div class="card-body">
                @if (property.Buildings != null && property.Buildings.Any())
                {
                    <table class="table table-hover align-middle border">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 20%;">Tên dãy</th>
                                <th style="width: 65%;">Danh sách phòng (Click để sửa)</th>
                                <th style="width: 15%;" class="text-center">Hành động dãy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in property.Buildings)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">
                                        <i class="fas fa-layer-group me-1"></i> @b.Name
                                    </td>
                                    <td>
                                        @if (b.Rooms != null && b.Rooms.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var room in b.Rooms.OrderBy(r => r.RoomNumber))
                                                {
                                                    string statusClass = room.Status switch
                                                    {
                                                        RoomStatus.Available => "bg-success",
                                                        RoomStatus.Occupied => "bg-danger",
                                                        RoomStatus.Reserved => "bg-warning text-dark",
                                                        RoomStatus.Maintenance => "bg-secondary",
                                                        _ => "bg-light text-dark"
                                                    };

                                                    string tooltipContent = $"Giá: {room.BasePrice:N0}đ | Tiền cọc: {room.DepositAmount:N0}đ | Trạng thái: {room.Status}";

                                                    <a asp-controller="Room" asp-action="Edit" asp-route-id="@room.Id"
                                                       class="badge @statusClass p-2 shadow-sm rounded-pill text-decoration-none"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-html="true"
                                                       title="<div class='small text-start'>@tooltipContent</div>"
                                                       style="min-width: 55px; transition: transform 0.2s;">
                                                        <i class="fas @(room.Status == RoomStatus.Occupied ? "fa-user" : "fa-door-open") me-1"></i>
                                                        @room.RoomNumber
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i>Chưa có phòng</i></span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group shadow-sm">
                                            <a asp-controller="Room" asp-action="Create" asp-route-buildingId="@b.Id"
                                               class="btn btn-sm btn-outline-success" title="Thêm phòng mới">
                                                <i class="fas fa-plus"></i>
                                            </a>

                                            <a asp-controller="Building" asp-action="Edit" asp-route-id="@b.Id"
                                               class="btn btn-sm btn-outline-primary" title="Sửa tên dãy">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <form asp-controller="Building" asp-action="Delete" asp-route-id="@b.Id"
                                                  method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa dãy này không?');"
                                                  style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa dãy">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted italic">Chưa có dãy nào được tạo cho khu này.</p>
                }

                <div class="mt-3 d-flex gap-2">
                    <a asp-controller="Building" asp-action="Create" asp-route-propertyId="@property.Id"
                       class="btn btn-primary shadow-sm">
                        <i class="fas fa-plus-circle me-1"></i> Thêm dãy mới
                    </a>

                    <a asp-controller="Property" asp-action="EditPricing" asp-route-id="@property.Id"
                       class="btn btn-outline-secondary shadow-sm">
                        <i class="fas fa-file-invoice-dollar me-1"></i> Cấu hình giá & Phí dịch vụ
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Kích hoạt Tooltip của Bootstrap cho các số phòng
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
    <style>
        /* Hiệu ứng phóng to nhẹ khi di chuột vào số phòng */
        .badge:hover {
            transform: scale(1.1);
            filter: brightness(1.1);
        }
    </style>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />