@model BoardingHouseManagement.ViewModels.Admin.AdminInvoiceDetailsVM
@using BoardingHouseManagement.Models

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var invoice = Model.Invoice;
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">
        <span class="text-muted fw-light">Hóa đơn /</span> Chi tiết #@invoice.InvoiceCode
    </h4>

    <div class="row">
        <!-- Invoice Details -->
        <div class="col-md-7">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Thông tin chi tiết</h5>
                    <span class="badge @(invoice.Status == InvoiceStatus.Paid ? "bg-success" : invoice.Status == InvoiceStatus.Overdue ? "bg-danger" : "bg-warning")">
                        @invoice.Status
                    </span>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Kỳ hóa đơn:</div>
                        <div class="col-sm-8 text-primary fw-bold">Tháng @invoice.Month / @invoice.Year</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Khách thuê:</div>
                        <div class="col-sm-8">@Model.TenantName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Phòng / Khu:</div>
                        <div class="col-sm-8">Phòng @Model.RoomNumber - @Model.PropertyName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold">Hạn thanh toán:</div>
                        <div class="col-sm-8 text-danger">@invoice.DueDate.ToString("dd/MM/yyyy")</div>
                    </div>

                    <hr class="my-4" />

                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Hạng mục</th>
                                    <th class="text-end">Số tiền (VNĐ)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Tiền phòng</td>
                                    <td class="text-end">@invoice.RoomAmount.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>
                                        Tiền điện & nước
                                        <div class="small text-muted">(Bao gồm lượng sử dụng Điện + Nước theo chỉ số tháng @invoice.Month)</div>
                                    </td>
                                    <td class="text-end">@invoice.UtilityAmount.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>Phí dịch vụ</td>
                                    <td class="text-end">@invoice.ServiceAmount.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>Phụ phí / Phạt</td>
                                    <td class="text-end text-danger">@invoice.PenaltyAmount.ToString("N0")</td>
                                </tr>
                            </tbody>
                            <tfoot class="table-dark">
                                <tr>
                                    <th class="text-uppercase">Tổng cộng</th>
                                    <th class="text-end fs-5">@invoice.TotalAmount.ToString("N0")</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="mt-4 d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                        @if (invoice.Status != InvoiceStatus.Paid)
                        {
                            <a asp-action="Edit" asp-route-id="@invoice.Id" class="btn btn-warning">
                                <i class="bx bx-edit-alt me-1"></i>Chỉnh sửa
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment History -->
        <div class="col-md-5">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bx bx-history me-1"></i>Lịch sử thanh toán</h5>
                </div>
                <div class="card-body">
                    @if (!Model.Payments.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bx bx-info-circle fs-1 text-muted"></i>
                            <p class="mt-2 mb-0">Chưa có giao dịch nào được thực hiện.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Thời gian</th>
                                        <th>Phương thức</th>
                                        <th class="text-end">Số tiền</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model.Payments)
                                    {
                                        <tr>
                                            <td><small>@payment.CreatedAt.ToString("dd/MM HH:mm")</small></td>
                                            <td><span class="badge bg-label-info">@payment.PaymentMethod</span></td>
                                            <td class="text-end fw-bold">@payment.Amount.ToString("N0")</td>
                                            <td>
                                                @if (payment.Status == PaymentStatus.Success)
                                                {
                                                    <span class="text-success"><i class="bx bx-check-circle"></i></span>
                                                }
                                                else if (payment.Status == PaymentStatus.Pending)
                                                {
                                                    <span class="text-warning"><i class="bx bx-loader fs-tiny"></i></span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger"><i class="bx bx-x-circle"></i></span>
                                                }
                                            </td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(payment.VnpTransactionNo))
                                        {
                                            <tr>
                                                <td colspan="4" class="py-0 border-0">
                                                    <small class="text-muted" style="font-size: 0.7rem;">Mã VNPAY: @payment.VnpTransactionNo</small>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Notes or Activity -->
            <div class="alert alert-info" role="alert">
                <h6 class="alert-heading fw-bold mb-1">Ghi chú hệ thống:</h6>
                <p class="mb-0 small">Hóa đơn này được tạo tự động/thủ công dựa trên hợp đồng thuê phòng @Model.RoomNumber. Luồng thanh toán được tích hợp qua cổng VNPAY an toàn.</p>
            </div>
        </div>
    </div>
</div>
