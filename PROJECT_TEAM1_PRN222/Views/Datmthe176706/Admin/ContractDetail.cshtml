@model BoardingHouseManagement.Models.Contract
@using BoardingHouseManagement.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_AdminLayout";
}
<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4"><span class="text-muted fw-light">Quản lý /</span> Chi tiết hợp đồng</h4>

    <div class="row">
        <div class="col-xl-8 col-lg-7 col-md-12">
            <div class="nav-align-top nav-tabs-shadow mb-4">
                <ul class="nav nav-tabs nav-fill" role="tablist">
                    <li class="nav-item">
                        <button type="button" class="nav-link active" role="tab" data-bs-toggle="tab" data-bs-target="#tab-general">
                            <i class="bx bx-file me-1"></i> Điều khoản hợp đồng
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#tab-tenant">
                            <i class="bx bx-user me-1"></i> Người thuê (Tenant)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link" role="tab" data-bs-toggle="tab" data-bs-target="#tab-room">
                            <i class="bx bx-home me-1"></i> Phòng & Tòa nhà
                        </button>
                    </li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="text-muted d-block small">Mã hợp đồng</label>
                                <span class="fw-bold text-primary">#@Model.Id.ToString().Substring(0, 8).ToUpper()</span>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted d-block small">Trạng thái hiệu lực</label>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-label-success">Đang hiệu lực</span>
                                }
                                else if (Model.Room?.Status.ToString() == "Available")
                                {
                                    <span class="badge bg-label-danger">Đã kết thúc/Hủy</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-warning">Chờ kích hoạt</span>
                                }
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted d-block small">Ngày bắt đầu</label>
                                <span class="fw-bold">@Model.StartDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted d-block small">Ngày kết thúc (Dự kiến)</label>
                                <span>@(Model.EndDate?.ToString("dd/MM/yyyy") ?? "Hợp đồng dài hạn")</span>
                            </div>
                            <div class="col-12">
                                <label class="text-muted d-block small">Tiền cọc thực tế</label>
                                <h4 class="text-success mb-0">@Model.ActualDeposit.ToString("N0") VNĐ</h4>
                            </div>

                            <div class="col-12 mt-4">
                                <hr />
                                <h6><i class="bx bx-image-alt me-1"></i> Ảnh minh chứng hợp đồng/thanh toán</h6>
                                @if (!string.IsNullOrEmpty(Model.ContractProofImage))
                                {
                                    <div class="bg-light p-3 rounded text-center">
                                        <a href="~/uploads/contracts/@Model.ContractProofImage" target="_blank">
                                            <img src="~/uploads/contracts/@Model.ContractProofImage" class="img-thumbnail shadow-sm" style="max-height: 400px;" />
                                        </a>
                                        <p class="small text-muted mt-2 mb-0">* Ảnh chữ ký hoặc hóa đơn đặt cọc</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-secondary mb-0">
                                        <i class="bx bx-info-circle me-1"></i> Chưa có ảnh minh chứng.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab-tenant" role="tabpanel">
                        <div class="d-flex align-items-center mb-4">
                            <div class="avatar avatar-md me-3">
                                <span class="avatar-initial rounded-circle bg-label-info">
                                    @(Model.Tenan?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-0">@Model.Tenan?.FullName</h5>
                                <small class="text-muted">CCCD: @Model.Tenan?.IdentityNumber</small>
                            </div>
                        </div>
                        <div class="row shadow-none border rounded p-3">
                            <div class="col-sm-6 mb-3">
                                <small class="text-muted d-block">Email</small>
                                <strong>@Model.Tenan?.Email</strong>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <small class="text-muted d-block">Số điện thoại</small>
                                <strong>@Model.Tenan?.Phone</strong>
                            </div>
                         
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab-room" role="tabpanel">
                        <div class="row g-4">
                            <div class="col-md-6 border-end">
                                <h6 class="text-primary"><i class="bx bx-home-circle me-1"></i> Thông tin phòng</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2"><strong>Số phòng:</strong> @Model.Room?.RoomNumber</li>
                                    <li class="mb-2"><strong>Giá thuê niêm yết:</strong> @Model.Room?.BasePrice.ToString("N0") đ</li>
                                    <li><strong>Trạng thái hiện tại:</strong> @Model.Room?.Status</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-primary"><i class="bx bx-building me-1"></i> Thông tin tòa nhà</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2"><strong>Tòa nhà:</strong> @Model.Room?.Building?.Name</li>
                                  
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="ContractList" class="btn btn-label-secondary">
                    <i class="bx bx-chevron-left me-1"></i> Quay lại danh sách
                </a>

                <div class="d-flex gap-2">
                    @if (!Model.IsActive && Model.Room?.Status.ToString() != "Available")
                    {
                        <form asp-action="ActivateContract" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success">
                                <i class="bx bx-bolt-circle me-1"></i> Kích hoạt hợp đồng
                            </button>
                        </form>
                    }

                    @if (Model.IsActive)
                    {
                        <form asp-action="TerminateContract" method="post" onsubmit="return confirm('Xác nhận kết thúc hợp đồng này?')">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger">Kết thúc HĐ</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-5 col-md-12">
            <div class="card bg-lighter shadow-none border-0 mb-4">
                <div class="card-body">
                    <h6 class="mb-3">Tiến độ hợp đồng</h6>
                    <div class="d-flex align-items-start mb-3">
                        <div class="badge bg-label-primary p-2 me-3 rounded"><i class="bx bx-edit"></i></div>
                        <div class="flex-grow-1">
                            <p class="mb-0 fw-bold">1. Khởi tạo</p>
                            <small class="text-muted">Đã tạo bản thảo hợp đồng.</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-start mb-3">
                        <div class="badge @(Model.IsActive ? "bg-label-success" : "bg-label-secondary") p-2 me-3 rounded">
                            <i class="bx bx-check"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p class="mb-0 fw-bold">2. Thanh toán & Ký kết</p>
                            <small class="text-muted">Admin xác nhận tiền cọc.</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-start">
                        <div class="badge @(Model.IsActive ? "bg-label-info" : "bg-label-secondary") p-2 me-3 rounded">
                            <i class="bx bx-key"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p class="mb-0 fw-bold">3. Bàn giao phòng</p>
                            <small class="text-muted">Khách bắt đầu ở.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-info">
                <h6 class="alert-heading fw-bold mb-1">Lưu ý:</h6>
                <p class="mb-0 small">Mọi thay đổi về tiền thuê hoặc người ở cùng cần được lập phụ lục hợp đồng mới.</p>
            </div>
        </div>
    </div>
</div>