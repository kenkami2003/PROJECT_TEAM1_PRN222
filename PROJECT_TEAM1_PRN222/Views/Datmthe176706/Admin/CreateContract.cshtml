@model BoardingHouseManagement.Models.Contract
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lập Hợp Đồng Chính Thức";
    var reservation = ViewBag.Reservation as BoardingHouseManagement.Models.Reservation;
}
<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4"><span class="text-muted fw-light">Quản lý /</span> Lập Hợp Đồng</h4>

    <div class="card mb-4">
        <h5 class="card-header">Thông tin hợp đồng cho khách @reservation?.Guest?.FullName</h5>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <input type="hidden" name="reservationId" value="@reservation?.Id" />
                <input type="hidden" asp-for="TenantId" />
                <input type="hidden" asp-for="RoomId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Phòng</label>
                        <input type="text" class="form-control" value="@reservation?.Room?.RoomNumber" disabled />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ActualDeposit" class="form-label">Tiền cọc thực tế (VNĐ)</label>
                        <input asp-for="ActualDeposit" class="form-control" type="number" step="1000" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label">Ngày kết thúc</label>
                        <input asp-for="EndDate" class="form-control" type="date" />
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary me-2"><i class="bx bx-save me-1"></i> Lưu hợp đồng</button>
                    <a asp-controller="Reservations" asp-action="ReservationList" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
