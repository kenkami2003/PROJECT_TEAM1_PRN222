@model BoardingHouseManagement.Models.Invoice
@using BoardingHouseManagement.Models

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chi tiết hoá đơn";
    var invoice = Model;
    var latestPayment = invoice.Payments?.OrderByDescending(p => p.CreatedAt).FirstOrDefault();
    var isPaid = invoice.Status == InvoiceStatus.Paid;
    
    // Tìm chỉ số điện nước cho tháng này (nếu có)
    var utilityInfo = invoice.Contract?.Room?.UtilityReadings?.FirstOrDefault(u => u.Month == invoice.Month && u.Year == invoice.Year);
}

<div class="container-fluid header bg-white p-0">
    <div class="row g-0 align-items-center flex-column-reverse flex-md-row">
        <div class="col-md-6 p-5 mt-lg-5">
            <h1 class="display-5 animated fadeIn mb-4">Chi Tiết Hoá Đơn</h1>
            <nav aria-label="breadcrumb animated fadeIn">
                <ol class="breadcrumb text-uppercase">
                    <li class="breadcrumb-item"><a href="/Datmthe176706/Users">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/Datmthe176706/Users/MyInvoices">Hóa đơn của tôi</a></li>
                    <li class="breadcrumb-item text-body active" aria-current="page">Chi tiết</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-6 animated fadeIn">
            <img class="img-fluid" src="~/user/img/header.jpg" alt="">
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <!-- Invoice Information -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold">Hoá đơn Kỳ @invoice.Month / @invoice.Year</h5>
                    <span class="badge @(isPaid ? "bg-success" : "bg-warning text-dark") px-3 py-2">
                        <i class="fa @(isPaid ? "fa-check-circle" : "fa-exclamation-circle") me-1"></i>
                        @(isPaid ? "ĐÃ THANH TOÁN" : "CHƯA THANH TOÁN")
                    </span>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Mã hóa đơn</small>
                            <span class="fw-bold fs-5 text-dark">@invoice.InvoiceCode</span>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <small class="text-muted d-block">Hạn thanh toán</small>
                            <span class="fw-bold text-danger fs-5">@invoice.DueDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="bg-light">
                                <tr>
                                    <th>Hạng mục chi phí</th>
                                    <th class="text-end">Thành tiền (VNĐ)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="fw-bold">Tiền thuê phòng</div>
                                        <small class="text-muted">Phòng @invoice.Contract?.Room?.RoomNumber - @invoice.Contract?.Room?.Building?.Name</small>
                                    </td>
                                    <td class="text-end fw-bold">@invoice.RoomAmount.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="fw-bold">Tiền Điện & Nước</div>
                                        @if (utilityInfo != null)
                                        {
                                            <div class="small text-muted mt-1">
                                                <i class="fa fa-bolt me-1"></i> Điện: @utilityInfo.OldElectricity - @utilityInfo.NewElectricity (@(utilityInfo.NewElectricity - utilityInfo.OldElectricity) kWh)<br />
                                                <i class="fa fa-tint me-1"></i> Nước: @utilityInfo.OldWater - @utilityInfo.NewWater (@(utilityInfo.NewWater - utilityInfo.OldWater) khối)
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end fw-bold">@invoice.UtilityAmount.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="fw-bold">Phí dịch vụ cố định</div>
                                        <small class="text-muted">Rác, Vệ sinh, Wifi...</small>
                                    </td>
                                    <td class="text-end fw-bold">@invoice.ServiceAmount.ToString("N0")</td>
                                </tr>
                                @if (invoice.PenaltyAmount > 0)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-danger">Phụ phí/Phạt</div>
                                        </td>
                                        <td class="text-end fw-bold text-danger">@invoice.PenaltyAmount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="border-top-2 border-primary">
                                    <td class="fs-4 fw-bold text-primary py-3">TỔNG CỘNG</td>
                                    <td class="fs-4 fw-bold text-primary text-end py-3">@invoice.TotalAmount.ToString("N0") VNĐ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="fa fa-history text-secondary me-2"></i>Lịch sử giao dịch</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Ngày</th>
                                    <th>Mã GD</th>
                                    <th>Phương thức</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (invoice.Payments != null && invoice.Payments.Any())
                                {
                                    foreach (var p in invoice.Payments.OrderByDescending(x => x.CreatedAt))
                                    {
                                        <tr>
                                            <td>@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td><small class="text-muted">@p.VnpTransactionNo</small></td>
                                            <td><span class="badge bg-secondary">@p.PaymentMethod</span></td>
                                            <td>
                                                @if (p.Status == PaymentStatus.Success)
                                                {<span class="text-success"><i class="fa fa-check-circle"></i> Thành công</span>}
                                                else if (p.Status == PaymentStatus.Pending)
                                                {<span class="text-warning"><i class="fa fa-spinner fa-spin"></i> Chờ xử lý</span>}
                                                else
                                                {<span class="text-danger"><i class="fa fa-times-circle"></i> Thất bại</span>}
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">Chưa có bản ghi giao dịch nào.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar / Action Card -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4 sticky-top" style="top: 100px;">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 text-white"><i class="fa fa-credit-card me-2"></i>Thanh toán</h5>
                </div>
                <div class="card-body">
                    @if (isPaid)
                    {
                        <div class="text-center py-4">
                            <div class="mb-3 text-success">
                                <i class="fa fa-check-circle fa-4x animated zoomIn"></i>
                            </div>
                            <h4 class="text-success">Đã hoàn tất</h4>
                            <p class="text-muted">Hoá đơn đã được thanh toán đầy đủ vào @(latestPayment?.PaidAt?.ToString("dd/MM/yyyy HH:mm"))</p>
                            <a href="/Datmthe176706/Users/MyInvoices" class="btn btn-outline-primary w-100">Quay lại danh sách</a>
                        </div>
                    }
                    else
                    {
                        <div class="mb-4">
                            <p class="text-muted mb-2">Vui lòng kiểm tra kỹ thông tin chi phí trước khi thực hiện thanh toán qua cổng VNPAY.</p>
                            <div class="alert alert-warning border-0 small">
                                <i class="fa fa-info-circle me-1"></i> Sau khi quẹt thẻ thành công, trạng thái hoá đơn sẽ được cập nhật tự động.
                            </div>
                        </div>

                        <form asp-controller="Payment" asp-action="Process" asp-area="" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="invoiceId" value="@invoice.Id" />
                            <button type="submit" class="btn btn-primary w-100 py-3 mb-3 shadow">
                                <img src="https://sandbox.vnpayment.vn/paymentv2/Assets/Images/logoVNPAY.png"
                                     height="25" class="me-2" alt="VNPAY"
                                     onerror="this.style.display='none'" />
                                <i class="fa fa-lock me-1"></i> Thanh toán ngay
                            </button>
                        </form>
                        <a href="/Datmthe176706/Users/MyInvoices" class="btn btn-light w-100 py-2">Quay lại danh sách</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
