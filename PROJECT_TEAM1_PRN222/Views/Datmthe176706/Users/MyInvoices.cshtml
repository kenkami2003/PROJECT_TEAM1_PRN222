@model IEnumerable<BoardingHouseManagement.Models.Invoice>
@using BoardingHouseManagement.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Hoá đơn của tôi";
}

<!-- Page Header -->
<div class="container-fluid header bg-white p-0">
    <div class="row g-0 align-items-center flex-column-reverse flex-md-row">
        <div class="col-md-6 p-5 mt-lg-5">
            <h1 class="display-5 animated fadeIn mb-4">
                <i class="fa fa-file-invoice-dollar text-primary me-2"></i>Hoá Đơn Của Tôi
            </h1>
            <nav aria-label="breadcrumb animated fadeIn">
                <ol class="breadcrumb text-uppercase">
                    <li class="breadcrumb-item"><a href="/Datmthe176706/Users">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/Datmthe176706/Users/MyRoom">Phòng của tôi</a></li>
                    <li class="breadcrumb-item text-body active" aria-current="page">Hoá đơn</li>
                </ol>
            </nav>
        </div>
        <div class="col-md-6 animated fadeIn">
            <img class="img-fluid" src="~/user/img/header.jpg" alt="">
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- TempData Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fa fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="fa fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Invoice Cards -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fa fa-file-invoice fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">Chưa có hoá đơn nào</h4>
            <p class="text-muted">Hệ thống sẽ tự động tạo hoá đơn hàng tháng cho phòng bạn đang thuê.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var invoice in Model)
            {
                var latestPayment = invoice.Payments?.OrderByDescending(p => p.CreatedAt).FirstOrDefault();
                var isPaid = invoice.Status == InvoiceStatus.Paid;
                var isOverdue = invoice.Status == InvoiceStatus.Overdue;

                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 h-100 @(isPaid ? "border-success" : isOverdue ? "border-danger" : "") " style="border-left: 4px solid @(isPaid ? "#28a745" : isOverdue ? "#dc3545" : "#0d6efd") !important;">
                        <div class="card-header d-flex justify-content-between align-items-center py-3"
                             style="background: @(isPaid ? "#f0fff4" : isOverdue ? "#fff5f5" : "#f0f4ff")">
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">
                                    Hoá đơn tháng @invoice.Month / @invoice.Year
                                </h6>
                                <small class="text-muted">@invoice.InvoiceCode</small>
                            </div>
                            @if (isPaid)
                            {
                                <span class="badge bg-success px-3 py-2"><i class="fa fa-check me-1"></i>Đã thanh toán</span>
                            }
                            else if (isOverdue)
                            {
                                <span class="badge bg-danger px-3 py-2"><i class="fa fa-clock me-1"></i>Quá hạn</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-3 py-2"><i class="fa fa-hourglass-half me-1"></i>Chưa thanh toán</span>
                            }
                        </div>

                        <div class="card-body">
                            <!-- Breakdown -->
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Tiền phòng</small>
                                    <span class="fw-semibold">@invoice.RoomAmount.ToString("N0") đ</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Điện - Nước</small>
                                    <span class="fw-semibold">@invoice.UtilityAmount.ToString("N0") đ</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Dịch vụ</small>
                                    <span class="fw-semibold">@invoice.ServiceAmount.ToString("N0") đ</span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Phạt</small>
                                    <span class="fw-semibold @(invoice.PenaltyAmount > 0 ? "text-danger" : "")">@invoice.PenaltyAmount.ToString("N0") đ</span>
                                </div>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="fw-bold fs-6">Tổng cộng:</span>
                                <span class="fw-bold fs-5 text-primary">@invoice.TotalAmount.ToString("N0") đ</span>
                            </div>

                            <!-- Payment status badge from latest payment -->
                            @if (latestPayment != null && !isPaid)
                            {
                                <div class="mb-3">
                                    @if (latestPayment.Status == PaymentStatus.Pending)
                                    {
                                        <span class="badge bg-info text-dark"><i class="fa fa-spinner fa-spin me-1"></i>Giao dịch đang xử lý...</span>
                                    }
                                    else if (latestPayment.Status == PaymentStatus.Failed)
                                    {
                                        <span class="badge bg-danger"><i class="fa fa-times me-1"></i>Giao dịch trước thất bại</span>
                                    }
                                    else if (latestPayment.Status == PaymentStatus.Cancelled)
                                    {
                                        <span class="badge bg-secondary"><i class="fa fa-ban me-1"></i>Giao dịch bị huỷ</span>
                                    }
                                </div>
                            }

                            <!-- VNPAY Payment Button -->
                            @if (!isPaid)
                            {
                                <form asp-controller="Payment" asp-action="Process" asp-area="" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="invoiceId" value="@invoice.Id" />
                                    <button type="submit" class="btn btn-primary w-100 shadow-sm py-2">
                                        <img src="https://sandbox.vnpayment.vn/paymentv2/Assets/Images/logoVNPAY.png"
                                             height="20" class="me-2" alt="VNPAY"
                                             onerror="this.style.display='none'" />
                                        <i class="fa fa-credit-card me-1"></i> Thanh toán qua VNPAY
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="text-center text-success fw-semibold py-2">
                                    <i class="fa fa-check-circle me-1"></i> Hoá đơn đã được thanh toán
                                    @if (latestPayment?.PaidAt != null)
                                    {
                                        <small class="d-block text-muted">lúc @latestPayment.PaidAt?.ToString("HH:mm dd/MM/yyyy")</small>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
