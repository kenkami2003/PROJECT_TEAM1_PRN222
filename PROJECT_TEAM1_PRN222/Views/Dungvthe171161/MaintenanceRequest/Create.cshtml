@model BoardingHouseManagement.Models.MaintenanceRequest
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";
}

<h2>Create Request</h2>

<form asp-controller="MaintenanceRequest" asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <!-- HIỂN THỊ LỖI -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- TITLE -->
    <div class="form-group">
        <label asp-for="Title">Tiêu đề</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <!-- IMAGE URL -->
    <div class="form-group mt-2">
        <label asp-for="ImageUrl"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <!-- DESCRIPTION -->
    <div class="form-group mt-2">
        <label asp-for="Description">Mô tả</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <!-- ROOM -->
    <div class="form-group mt-2">
        <label asp-for="RoomId">Phòng</label>
        <select asp-for="RoomId"
                asp-items="@(new SelectList(ViewBag.Rooms, "Id", "RoomNumber"))"
                class="form-control">
            <option value="">-- Chọn phòng --</option>
        </select>
        
    </div>

    <!-- SUBMIT -->
    <button type="submit" class="btn btn-success mt-3">Submit</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}