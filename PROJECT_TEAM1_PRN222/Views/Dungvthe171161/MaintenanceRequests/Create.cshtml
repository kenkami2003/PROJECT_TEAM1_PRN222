@model BoardingHouseManagement.Models.MaintenanceRequest

@{
    Layout = "~/Views/Datmthe176706/Admin/_LayoutAdmin.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="bx bx-wrench me-2"></i> Create Maintenance Request
        </h5>
    </div>

    <div class="card-body">
        <form method="post">

            <!-- Title -->
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" placeholder="Enter title..." />
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <!-- Room -->
            <div class="mb-3">
                <label class="form-label">Room</label>
                <select asp-for="RoomId" class="form-select">
                    <option value="">-- Select Room --</option>
                    @foreach (var room in ViewBag.Rooms)
                    {
                        <option value="@room.Id">@room.RoomNumber</option>
                    }
                </select>
            </div>

            <!-- Tenant -->
            <div class="mb-3">
                <label class="form-label">TenantId</label>
                <input asp-for="TenantId" class="form-control" placeholder="Enter TenantId..." />
            </div>

            <!-- Buttons -->
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bx bx-save"></i> Create
                </button>

                <a href="/MaintenanceRequests" class="btn btn-secondary">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>