@model List<BoardingHouseManagement.Models.MaintenanceRequest>
@using BoardingHouseManagement.Models

@{
    Layout = "~/Views/Datmthe176706/Admin/_LayoutAdmin.cshtml";
    var currentStatus = Context.Request.Query["status"];
}

<div class="card">

    <!-- HEADER -->
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bx bx-wrench me-2"></i>
            Yêu cầu bảo trì (@Model.Count)
        </h5>

        <a href="/MaintenanceRequests/Create" class="btn btn-primary btn-sm">
            <i class="bx bx-plus"></i> New Request
        </a>
    </div>

    <!-- FILTER -->
    <div class="card-body pb-0">
        <div class="mb-3">

            <a href="/MaintenanceRequests"
               class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-outline-secondary")">
                All
            </a>

            <a href="/MaintenanceRequests?status=Open"
               class="btn btn-sm @(currentStatus == "Open" ? "btn-primary" : "btn-outline-secondary")">
                Open
            </a>

            <a href="/MaintenanceRequests?status=Processing"
               class="btn btn-sm @(currentStatus == "Processing" ? "btn-warning" : "btn-outline-warning")">
                Processing
            </a>

            <a href="/MaintenanceRequests?status=Fixed"
               class="btn btn-sm @(currentStatus == "Fixed" ? "btn-success" : "btn-outline-success")">
                Fixed
            </a>

        </div>
    </div>

    <!-- TABLE -->
    <div class="table-responsive text-nowrap">
        <table class="table table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>Room</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Time</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bx bx-inbox fs-2"></i>
                            <div>No requests found</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- ROOM -->
                            <td>
                                <span class="badge bg-info">
                                    Room @item.Room?.RoomNumber
                                </span>
                            </td>

                            <!-- TITLE -->
                            <td class="fw-semibold">
                                @item.Title
                            </td>

                            <!-- DESCRIPTION -->
                            <td style="max-width:250px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                                title="@item.Description">

                                @(string.IsNullOrEmpty(item.Description)
                                                        ? "-"
                                                        : (item.Description.Length > 40
                                                        ? item.Description.Substring(0, 40) + "..."
                                                        : item.Description))
                    </td>

                            <!-- STATUS -->
                            <td>
                        @if (item.Status == RequestStatus.Open)
                                {
                                    <span class="badge bg-secondary">Open</span>
                                }
                                else if (item.Status == RequestStatus.Processing)
                                {
                                    <span class="badge bg-warning text-dark">Processing</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Fixed</span>
                                }
                            </td>

                            <!-- TIME -->
                            <td>
                                <span class="text-muted">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </td>

                            <!-- ACTION -->
                            <td>
                                <a href="/MaintenanceRequests/Edit/@item.Id"
                                   class="btn btn-sm btn-outline-warning">
                                    <i class="bx bx-edit"></i> Edit
                                </a>

                                <button class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#checkoutModal"
                                        onclick="setRoom('@item.RoomId', 'Room @item.Room?.RoomNumber')">
                                    <i class="bx bx-log-out"></i> Check-out
                                </button>
                            </td>

                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>

</div>

<!-- ✅ CHECKOUT MODAL (CHỈ 1 CÁI DUY NHẤT) -->
<div class="modal fade" id="checkoutModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bx bx-error-circle text-danger"></i>
                    Xác nhận Check-out
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p id="checkoutText"></p>
            </div>

            <div class="modal-footer">
                <form method="post"
                      asp-controller="StaffDashboard"
                      asp-action="CheckoutConfirmed">

                    <input type="hidden" name="roomId" id="roomIdInput" />

                    <button type="submit" class="btn btn-danger">
                        Xác nhận
                    </button>
                </form>

                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Hủy
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ✅ SCRIPT -->
@section PageScripts {
    <script>
        function setRoom(roomId, roomName) {
            console.log("CLICK OK");

            document.getElementById("roomIdInput").value = roomId;

            document.getElementById("checkoutText").innerHTML =
                "Bạn có chắc muốn check-out <b>" + roomName + "</b>?";
        }
    </script>
}
}