@{
    Layout = "~/Views/Datmthe176706/Admin/_LayoutAdmin.cshtml";
}

<h3 class="mb-4">📊 Staff Dashboard</h3>

<div class="row">

    <!-- TOTAL -->
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h2>@ViewBag.TotalRequests</h2>
                <p class="text-muted">Total Requests</p>
            </div>
        </div>
    </div>

    <!-- OPEN -->
    <div class="col-md-3">
        <div class="card shadow-sm border-start border-secondary border-4">
            <div class="card-body text-center">
                <h2>@ViewBag.OpenRequests</h2>
                <p class="text-muted">Open</p>
            </div>
        </div>
    </div>

    <!-- PROCESSING -->
    <div class="col-md-3">
        <div class="card shadow-sm border-start border-warning border-4">
            <div class="card-body text-center">
                <h2>@ViewBag.Processing</h2>
                <p class="text-muted">Processing</p>
            </div>
        </div>
    </div>

    <!-- FIXED -->
    <div class="col-md-3">
        <div class="card shadow-sm border-start border-success border-4">
            <div class="card-body text-center">
                <h2>@ViewBag.Fixed</h2>
                <p class="text-muted">Fixed</p>
            </div>
        </div>
    </div>

</div>

<hr />

<div class="row mt-4">

    <!-- QUICK ACTION -->
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">
                ⚡ Quick Actions
            </div>
            <div class="card-body d-flex gap-2">

                <a href="/MaintenanceRequests" class="btn btn-primary">
                    🔧 Requests
                </a>

                <a href="/AuditLogs" class="btn btn-dark">
                    📜 Audit Logs
                </a>

            </div>
        </div>
    </div>

    <!-- SYSTEM INFO -->
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">
                📌 System Info
            </div>
            <div class="card-body">
                <p>Total Logs: <b>@ViewBag.TotalLogs</b></p>
            </div>
        </div>
    </div>

</div>