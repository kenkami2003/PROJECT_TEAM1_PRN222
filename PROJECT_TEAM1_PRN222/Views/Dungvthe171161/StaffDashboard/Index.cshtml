@{
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";
}

<h3 class="mb-4">📊 Staff Dashboard</h3>

<div class="row">

    <div class="col-md-3">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                <h2>@ViewBag.TotalRequests</h2>
                <p class="text-muted">Total Requests</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-start border-secondary border-4 text-center">
            <div class="card-body">
                <h2>@ViewBag.OpenRequests</h2>
                <p class="text-muted">Open</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-start border-warning border-4 text-center">
            <div class="card-body">
                <h2>@ViewBag.Processing</h2>
                <p class="text-muted">Processing</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-start border-success border-4 text-center">
            <div class="card-body">
                <h2>@ViewBag.Fixed</h2>
                <p class="text-muted">Fixed</p>
            </div>
        </div>
    </div>

</div>

<hr />

<div class="row mt-4">

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">⚡ Quick Actions</div>
            <div class="card-body d-flex gap-2">

                <a asp-controller="MaintenanceRequests" asp-action="Index" class="btn btn-primary">
                    🔧 Requests
                </a>

                <a asp-controller="AuditLogs" asp-action="Index" class="btn btn-dark">
                    📜 Audit Logs
                </a>

            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">📌 System Info</div>
            <div class="card-body">
                <p>Total Logs: <b>@ViewBag.TotalLogs</b></p>
            </div>
        </div>
    </div>

</div>