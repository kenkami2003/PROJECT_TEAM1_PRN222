@model IEnumerable<BoardingHouseManagement.Models.MaintenanceRequest>
@using BoardingHouseManagement.Models
@{
    var u = ViewBag.UtilityVM as BoardingHouseManagement.Models.UtilityBatchViewModel;
}

<h3 class="mb-4">📊 Staff Dashboard</h3>

<!-- ===================== STATISTICS ===================== -->
<div class="row">

    <div class="col-md-3">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                <h2>@ViewBag.TotalRequests</h2>
                <p class="text-muted">Tổng số yêu cầu</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-start border-secondary border-4 text-center">
            <div class="card-body">
                <h2>@ViewBag.OpenRequests</h2>
                <p class="text-muted">Có thể sử dụng</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-start border-warning border-4 text-center">
            <div class="card-body">
                <h2>@ViewBag.Processing</h2>
                <p class="text-muted">Xử lý</p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-start border-success border-4 text-center">
            <div class="card-body">
                <h2>@ViewBag.Fixed</h2>
                <p class="text-muted">Đã sửa</p>
            </div>
        </div>
    </div>

</div>

<hr />

<!-- ===================== QUICK ACTION ===================== -->
<div class="row mt-4">

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">⚡ Quick Actions</div>
            <div class="card-body d-flex gap-2">
                <a href="/MaintenanceRequest" class="btn btn-primary btn-sm">
                    🔧 Requests
                </a>

                <a href="/AuditLogs" class="btn btn-primary btn-sm">
                    📜 Audit Logs
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">📌 System Info</div>
            <div class="card-body">
                <p>Total Logs: <b>@ViewBag.TotalLogs</b></p>
            </div>
        </div>
    </div>

</div>

<hr />

<!-- ===================== FILTER ===================== -->
<div class="mb-3">
    <a href="/StaffDashboard" class="btn btn-outline-secondary btn-sm">All</a>
    <a href="/StaffDashboard?status=Open" class="btn btn-outline-secondary btn-sm">Open</a>
    <a href="/StaffDashboard?status=Processing" class="btn btn-outline-warning btn-sm">Processing</a>
    <a href="/StaffDashboard?status=Fixed" class="btn btn-outline-success btn-sm">Fixed</a>
</div>

<!-- ===================== TABLE ===================== -->
<h4>📋 Request List</h4>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Room</th>
            <th>Created</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>

                <!-- STATUS BADGE -->
                <td>
                    <span class="badge
                                    @(item.Status == RequestStatus.Open ? "bg-secondary" :
                                                item.Status == RequestStatus.Processing ? "bg-warning text-dark" :
                                                "bg-success")">
                    @item.Status
                </span>
            </td>

                <td>@(item.Room?.RoomNumber ?? "N/A")</td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                <!-- ACTION BUTTON -->
                <td>
                    <form action="/StaffDashboard/UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="status" value="Open" />
                        <button type="submit" class="btn btn-secondary btn-sm">Open</button>
                    </form>

                    <form action="/StaffDashboard/UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="status" value="Processing" />
                        <button type="submit" class="btn btn-warning btn-sm">Processing</button>
                    </form>

                    <form action="/StaffDashboard/UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="status" value="Fixed" />
                        <button type="submit" class="btn btn-success btn-sm">Fixed</button>
                    </form>

                </td>
            </tr>
        }
    </tbody>
</table>
<h4>⚡ Nhập điện nước</h4>

<div class="card shadow-sm">
    <div class="card-body">

        <!-- FILTER -->
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4">
                <select name="propertyId" class="form-select" asp-items="ViewBag.PropertyList">
                    <option value="">-- Chọn khu trọ --</option>
                </select>
            </div>

            <div class="col-md-2">
                <input type="number" name="month" class="form-control" value="@u?.Month" />
            </div>

            <div class="col-md-2">
                <input type="number" name="year" class="form-control" value="@u?.Year" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-dark w-100">Lấy dữ liệu</button>
            </div>
        </form>

        @if (u != null && u.PropertyId != Guid.Empty)
        {
            <form asp-action="SaveBatch" asp-controller="StaffDashboard" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="PropertyId" value="@u.PropertyId" />
                <input type="hidden" name="Month" value="@u.Month" />
                <input type="hidden" name="Year" value="@u.Year" />

                <table class="table table-bordered">
                    <thead class="table-primary">
                        <tr>
                            <th>Phòng</th>
                            <th>Điện cũ</th>
                            <th>Điện mới</th>
                            <th>Nước cũ</th>
                            <th>Nước mới</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < u.Rooms.Count; i++)
                        {
                            <tr>
                                <td>
                                    @u.Rooms[i].RoomNumber
                                    <input type="hidden" name="Rooms[@i].RoomId" value="@u.Rooms[i].RoomId" />
                                </td>

                                <td>
                                    <input class="form-control"
                                           name="Rooms[@i].OldElectricity"
                                           value="@u.Rooms[i].OldElectricity" readonly />
                                </td>

                                <td>
                                    <input class="form-control"
                                           name="Rooms[@i].NewElectricity"
                                           value="@u.Rooms[i].NewElectricity" />
                                </td>

                                <td>
                                    <input class="form-control"
                                           name="Rooms[@i].OldWater"
                                           value="@u.Rooms[i].OldWater" readonly />
                                </td>

                                <td>
                                    <input class="form-control"
                                           name="Rooms[@i].NewWater"
                                           value="@u.Rooms[i].NewWater" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <button type="submit" class="btn btn-success">
                    💾 Lưu điện nước
                </button>
            </form>
        }

    </div>
</div>