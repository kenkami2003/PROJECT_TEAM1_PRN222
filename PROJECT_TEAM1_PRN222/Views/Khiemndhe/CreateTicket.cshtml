@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Gửi Yêu Cầu / Khiếu Nại";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0 py-2"><i class="fa fa-envelope-open-text me-2"></i> @ViewData["Title"]</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form asp-controller="Tickets" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tiêu đề yêu cầu</label>
                            <input type="text" name="title" class="form-control" placeholder="Ví dụ: Báo cáo hư hỏng điều hòa, phản ánh dịch vụ..." required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Nội dung chi tiết</label>
                            <textarea name="description" class="form-control" rows="6" placeholder="Mô tả rõ vấn đề bạn đang gặp phải để chúng tôi hỗ trợ tốt nhất..." required></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Tickets/Index" class="btn btn-outline-secondary px-4">Hủy</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="fa fa-paper-plane me-2"></i> Gửi yêu cầu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
