@using BoardingHouseManagement.Models
@model IEnumerable<User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Người dùng";
    var guardians = ViewBag.Guardians as Dictionary<Guid, Guardian>;
    var activeContracts = ViewBag.ActiveContracts as Dictionary<Guid, Contract>;
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0">Danh sách Người dùng</h5>
        <form asp-action="Index" method="get" class="d-flex">
            <input type="text" name="searchString" class="form-control me-2" placeholder="Tìm bằng tên, email, sđt..." value="@ViewBag.SearchString" />
            <button type="submit" class="btn btn-primary d-flex align-items-center"><i class="bx bx-search me-1"></i> Tìm</button>
        </form>
    </div>
    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Họ & Tên</th>
                    <th>Phòng đang thuê</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Người bảo hộ</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach(var item in Model)
                {
                    <tr>
                        <td><strong>@item.Username</strong></td>
                        <td>@item.FullName</td>
                        <td>
                            @if(activeContracts != null && activeContracts.ContainsKey(item.Id))
                            {
                                var contract = activeContracts[item.Id];
                                <span class="badge bg-label-info">P.@contract.Room?.RoomNumber - @contract.Room?.Building?.Name</span>
                            }
                            else
                            {
                                <span class="text-muted">Không có</span>
                            }
                        </td>
                        <td>@item.Email</td>
                        <td><span class="badge @(item.Role.RoleName == "Admin" ? "bg-label-primary" : "bg-label-success") me-1">@item.Role.RoleName</span></td>
                        <td>
                            @if(item.IsActive){ <span class="badge bg-success">Hoạt động</span> }
                            else { <span class="badge bg-danger">Khóa</span> }
                        </td>
                        <td>
                            @if(guardians != null && guardians.ContainsKey(item.Id))
                            {
                                <span>@guardians[item.Id].Name (@guardians[item.Id].Relationship)</span>
                            }
                            else
                            {
                                <span class="text-muted">Chưa cập nhật</span>
                            }
                        </td>
                        <td>
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="bx bx-dots-vertical-rounded"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" href="~/Admin/User/Edit/@item.Id"><i class="bx bx-edit-alt me-1"></i> Edit</a>
                                    <form action="~/Admin/User/Delete/@item.Id" method="post" style="display:inline;">
                                        <button type="submit" class="dropdown-item text-danger" onclick="return confirm('Khóa tài khoản này?');"><i class="bx bx-trash me-1"></i> Check out</button>
                                    </form>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
