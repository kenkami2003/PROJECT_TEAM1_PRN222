@model BoardingHouseManagement.Models.Property
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cấu hình giá dịch vụ";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Cấu hình giá: @Model.Name</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditPricing" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá điện (VNĐ/kWh)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-bolt text-warning"></i></span>
                                <input asp-for="PriceUnitElectricity" type="number" class="form-control" placeholder="Ví dụ: 3500" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá nước (VNĐ/m³)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-tint text-primary"></i></span>
                                <input asp-for="PriceUnitWater" type="number" class="form-control" placeholder="Ví dụ: 15000" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Phí dịch vụ cố định (VNĐ/tháng)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-concierge-bell text-success"></i></span>
                                <input asp-for="ServiceFee" type="number" class="form-control" placeholder="Ví dụ: 50000" />
                            </div>
                            <div class="form-text">Phí này sẽ cộng cố định vào hóa đơn mỗi tháng của mỗi phòng.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success flex-grow-1">Lưu cấu hình</button>
                            <a asp-controller="Building" asp-action="Index" class="btn btn-secondary">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>