@model IEnumerable<BoardingHouseManagement.Models.Property>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Quản lý khu trọ</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="fa-solid fa-plus me-2"></i>Thêm khu mới
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0 ps-4">Khu trọ</th>
                        <th class="border-0 text-center">Thao tác quản lý</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-primary">@item.Name</div>
                                <div class="text-muted small"><i class="fa-solid fa-location-dot me-1"></i>@item.Address</div>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-controller="Building"
                                       asp-action="Create"
                                       asp-route-propertyId="@item.Id"
                                       class="btn btn-sm btn-outline-success"
                                        title="Thêm dãy trọ">
                                        <i class="fa-solid fa-layer-group"></i>
                                    </a>

                                    <a asp-controller="Building" asp-route-propertyId="@item.Id"
                                       class="btn btn-sm btn-outline-info" title="Xem thông tin">
                                        <i class="fa-solid fa-circle-info"></i>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-warning" title="Sửa khu trọ">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa khu trọ này? Mọi dãy trọ bên trong cũng sẽ bị ảnh hưởng!');"
                                          style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* Hiệu ứng zoom nhẹ khi rê chuột vào hàng */
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: 0.3s;
    }
    /* Làm các nút bo tròn đẹp hơn */
    .btn-sm {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }
</style>