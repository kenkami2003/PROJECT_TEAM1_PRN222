    <!-- Script tự động active menu dựa trên URL hiện tại -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.toLowerCase();
            var menuLinks = document.querySelectorAll('.layout-menu .menu-link:not(.menu-toggle)');
            
            var bestMatch = null;
            var bestMatchLength = 0;

            // Tìm link gần giống với URL đang đứng nhất
            menuLinks.forEach(function (link) {
                var href = link.getAttribute('href');
                if (href && href !== 'javascript:void(0);' && href !== '#') {
                    // Cắt bỏ ký tự ~ để match với pathname
                    var linkPath = href.replace('~', '').toLowerCase();
                    if (currentPath === '/' && linkPath === '/') {
                        bestMatch = link;
                    } else if (linkPath !== '/' && currentPath.includes(linkPath)) {
                        if (linkPath.length > bestMatchLength) {
                            bestMatchLength = linkPath.length;
                            bestMatch = link;
                        }
                    }
                }
            });

            // Gỡ bỏ tất cả active mặc định (nếu có)
            document.querySelectorAll('.layout-menu .menu-item.active').forEach(function(el) {
                el.classList.remove('active');
            });

            // Gán lại active và open cho đúng thẻ
            if (bestMatch) {
                // Thêm active cho chính sub-menu đó
                var parentLi = bestMatch.closest('.menu-item');
                if (parentLi) {
                    parentLi.classList.add('active');
                }

                // Đi ngược lên dom tree tìm thẻ cha menu-item lớn chứa danh mục đó và mở ra
                var currentElement = bestMatch;
                while (currentElement) {
                    var menuSub = currentElement.closest('.menu-sub');
                    if (menuSub) {
                        var parentMenuItem = menuSub.closest('.menu-item'); // Thẻ cha chứa menu-toggle
                        if (parentMenuItem) {
                            parentMenuItem.classList.add('active', 'open');
                        }
                        currentElement = parentMenuItem; // Tiếp tục đi lên xem còn cha nữa không
                    } else {
                        break;
                    }
                }
            } else if (currentPath === '/' || currentPath === '/admin/portal') {
                // Fallback nếu không match cái nào cả thì gán cho dashboard
                var dashboardLink = document.querySelector('a[href="~/Admin/Portal"]');
                if (dashboardLink) {
                    var item = dashboardLink.closest('.menu-item');
                    if (item) item.classList.add('active');
                }
            }

            // Accordion: Khi mở 1 danh mục chính thì danh mục kia tự gập lại (VD: bấm "Quản lý Hợp đồng" thì gập "Quản lý trọ")
            var menuToggles = document.querySelectorAll('.menu-toggle');
            menuToggles.forEach(function(toggle) {
                toggle.addEventListener('click', function(e) {
                    var clickedLi = this.closest('.menu-item');
                    if (clickedLi && clickedLi.parentNode) {
                        // Tìm tất cả các thẻ Li cùng cấp
                        var siblings = Array.from(clickedLi.parentNode.children);
                        siblings.forEach(function(sibling) {
                            if (sibling !== clickedLi && sibling.classList.contains('open')) {
                                sibling.classList.remove('open');
                                // Nếu muốn loại bỏ sạch sẽ state (tuỳ chọn)
                                // sibling.classList.remove('active'); 
                            }
                        });
                    }
                });
            });
        });
    </script>

