<!DOCTYPE html>
<html lang="en"
      class="light-style layout-menu-fixed"
      dir="ltr"
      data-theme="theme-default"
      data-assets-path="/Admin/">

<head>
    <meta charset="utf-8" />
    <title>Staff Dashboard</title>

    <link rel="stylesheet" href="/Admin/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="/Admin/vendor/css/core.css" />
    <link rel="stylesheet" href="/Admin/vendor/css/theme-default.css" />
    <link rel="stylesheet" href="/Admin/css/demo.css" />

    <script src="/Admin/vendor/js/helpers.js"></script>
    <script src="/Admin/js/config.js"></script>
</head>

<body>

    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            <!-- SIDEBAR -->
            <aside class="layout-menu menu-vertical menu bg-menu-theme">

                <div class="app-brand demo">
                    <a href="#" onclick="loadPage('/StaffDashboard', event)" class="app-brand-link">
                        <span class="fw-bold">Staff</span>
                    </a>
                </div>

                <ul class="menu-inner py-1">

                    <li class="menu-item active">
                        <a href="#" onclick="loadPage('/StaffDashboard', event)" class="menu-link">
                            <i class="bx bx-home-circle"></i>
                            <div>Dashboard</div>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="#" onclick="loadPage('/MaintenanceRequests', event)" class="menu-link">
                            <i class="bx bx-wrench"></i>
                            <div>Yêu cầu bảo trì</div>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a href="#" onclick="loadPage('/AuditLogs', event)" class="menu-link">
                            <i class="bx bx-list-ul"></i>
                            <div>Nhật ký</div>
                        </a>
                    </li>

                </ul>

            </aside>

            <!-- PAGE -->
            <div class="layout-page">

                <!-- NAVBAR -->
                <nav class="layout-navbar navbar">
                    <div class="ms-auto me-3">
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger btn-sm">Logout</a>
                    </div>
                </nav>

                <!-- CONTENT -->
                <div class="container-xxl p-4">
                    <div id="mainContent">
                        @RenderBody()
                    </div>
                </div>

            </div>

        </div>
    </div>

    <script src="/Admin/vendor/libs/jquery/jquery.js"></script>
    <script src="/Admin/vendor/js/bootstrap.js"></script>

    <script>
        function loadPage(url, e) {
            if (e) e.preventDefault();

            fetch(url)
                .then(res => res.text())
                .then(html => {

                    let parser = new DOMParser();
                    let doc = parser.parseFromString(html, 'text/html');

                    let content = doc.querySelector(".container-xxl") || doc.body;

                    document.getElementById("mainContent").innerHTML = content.innerHTML;

                    // active menu
                    document.querySelectorAll('.menu-item').forEach(x => x.classList.remove('active'));
                    if (e) e.currentTarget.closest('.menu-item').classList.add('active');
                });
        }
    </script>

</body>
</html>