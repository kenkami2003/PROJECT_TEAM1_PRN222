<!DOCTYPE html>
<html lang="en"
      class="light-style layout-menu-fixed"
      dir="ltr"
      data-theme="theme-default"
      data-assets-path="/Admin/">

<head>
    <meta charset="utf-8" />
    <title>Staff Dashboard</title>

    <!-- CSS -->
    <link rel="stylesheet" href="~/Admin/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="~/Admin/vendor/css/core.css" />
    <link rel="stylesheet" href="~/Admin/vendor/css/theme-default.css" />
    <link rel="stylesheet" href="~/Admin/css/demo.css" />

    <!-- CONFIG -->
    <script src="~/Admin/vendor/js/helpers.js"></script>
    <script src="~/Admin/js/config.js"></script>

    <!-- OPTIONAL CSS -->
    @RenderSection("PageStyles", required: false)
</head>

<body>

    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            <!-- SIDEBAR -->
            <aside class="layout-menu menu-vertical menu bg-menu-theme">

                <div class="app-brand demo">
                    <a asp-controller="StaffDashboard" asp-action="Index" class="app-brand-link">
                        <span class="fw-bold">Staff</span>
                    </a>
                </div>

                <ul class="menu-inner py-1">

                    <li class="menu-item">
                        <a asp-controller="StaffDashboard" asp-action="Index" class="menu-link">
                            <i class="bx bx-home-circle"></i>
                            <div>Dashboard</div>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a asp-controller="MaintenanceRequest" asp-action="Index" class="menu-link">
                            <i class="bx bx-wrench"></i>
                            <div>Yêu cầu bảo trì</div>
                        </a>
                    </li>

                    <li class="menu-item">
                        <a asp-controller="AuditLogs" asp-action="Index" class="menu-link">
                            <i class="bx bx-list-ul"></i>
                            <div>Nhật ký</div>
                        </a>
                    </li>

                </ul>

            </aside>

            <!-- PAGE -->
            <div class="layout-page">

                <!-- NAVBAR -->
                <nav class="layout-navbar navbar">
                    <div class="ms-auto me-3">
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-danger btn-sm">
                            Logout
                        </a>
                    </div>
                </nav>

                <!-- CONTENT -->
                <div class="container-xxl p-4">
                    @RenderBody()
                </div>

            </div>

        </div>
    </div>

    <!-- CORE JS -->
    <script src="~/Admin/vendor/libs/jquery/jquery.js"></script>
    <script src="~/Admin/vendor/js/bootstrap.js"></script>
    <script src="~/Admin/js/main.js"></script>

    <!-- MENU ACTIVE SCRIPT -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.toLowerCase();
            var menuLinks = document.querySelectorAll('.layout-menu .menu-link');

            menuLinks.forEach(function (link) {
                var href = link.getAttribute('href');
                if (href && href.toLowerCase() === currentPath) {

                    document.querySelectorAll('.layout-menu .menu-item.active')
                        .forEach(el => el.classList.remove('active'));

                    var parentLi = link.closest('.menu-item');
                    if (parentLi) parentLi.classList.add('active');
                }
            });
        });

    </script>
    <style>
        .layout-page {
            position: relative;
            z-index: 10;
        }

        .layout-overlay {
            display: none !important;
        }
    </style>
    
    <!-- 🔥 QUAN TRỌNG NHẤT: FIX SECTION -->
    @RenderSection("PageScripts", required: false)
    @RenderSection("Scripts", required: false)

</body>
</html>